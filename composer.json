{
    "name": "kariricode/transformer",
    "description": "Rule-based data transformation for PHP 8.4: 32 built-in rules (case conversion, masking, CSV per RFC 4180, JSON, Base64, hashes, dates, numbers in words, array restructuring and Brazilian documents, the alphanumeric CNPJ included), nested field paths, a record of every change, attribute-driven transformation of readonly DTOs through the kariricode/contract Inspection ports, and a Processor for kariricode/processor-pipeline.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "kariricode",
        "transformer",
        "transformation",
        "case-conversion",
        "csv",
        "json",
        "dto",
        "attributes"
    ],
    "homepage": "https://github.com/KaririCode-PHP/transformer",
    "authors": [
        {
            "name": "Walmir Silva",
            "email": "walmir.silva@kariricode.org",
            "homepage": "https://kariricode.org",
            "role": "Lead Architect"
        }
    ],
    "support": {
        "issues": "https://github.com/KaririCode-PHP/transformer/issues",
        "source": "https://github.com/KaririCode-PHP/transformer",
        "security": "https://github.com/KaririCode-PHP/transformer/security/policy"
    },
    "require": {
        "php": "^8.4",
        "kariricode/contract": "^2.12",
        "kariricode/exception": "^2.0.2"
    },
    "suggest": {
        "kariricode/property-inspector": "Implements the kariricode/contract PropertyInspector and PropertyChangeApplier that AttributeTransformer reads #[Transform] attributes and writes transformed copies with (^3.0)"
    },
    "autoload": {
        "psr-4": {
            "KaririCode\\Transformer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KaririCode\\Transformer\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "kcode test",
        "test-unit": "kcode test --testsuite=unit,integration",
        "test-conformance": "kcode test --testsuite=conformance",
        "phpstan": "kcode run phpstan analyse --no-progress --memory-limit=1G",
        "psalm": "kcode run psalm --no-cache --show-info=false",
        "complexity": "@php tools/complexity.php",
        "mutation": [
            "Composer\\Config::disableProcessTimeout",
            "kcode run infection --threads=max --only-covering-test-cases --no-progress --show-mutations=0"
        ],
        "security": [
            "@composer validate --strict",
            "@composer audit --locked",
            "@composer audit --locked --working-dir=.kcode",
            "@php tools/secret-scan.php",
            "@php tools/secret-scan.php --self-test"
        ],
        "sbom": "@php tools/sbom.php sbom.cdx.json",
        "cs-check": "kcode cs:fix --check",
        "cs-fix": "kcode cs:fix",
        "check": [
            "@cs-check",
            "@phpstan",
            "@psalm",
            "@complexity",
            "@test",
            "@mutation"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "kariricode": {
            "arfa": {
                "version": "1.3",
                "level": 1
            },
            "asvs": {
                "version": "5.0",
                "level": 2
            },
            "spec": "4.3.3",
            "error-code-range": "TRF 3400–3499"
        },
        "branch-alias": {
            "dev-main": "3.x-dev"
        }
    }
}
